# TerraAgent Environment Configuration

# OpenAI API Key (used for agent inference, OCR extraction, and dossier generation)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Credentials (optional for cloud persistence; local fallback is built-in)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional Server-side Supabase Service Role Key (for Vercel serverless functions)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
